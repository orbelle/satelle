{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "satelle hook gate --harness claude",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "satelle hook context --harness claude",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "satelle hook stopcheck --harness claude",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "satelle hook prompt --harness claude",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(~/.fly/**)"
    ]
  }
}
