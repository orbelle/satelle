# Harness / agent local dirs — operator-owned. The one tracked file under
# .claude/ is settings.local.json: the Claude cloud-session hook carrier
# (scripts/claude-cloud-hook.sh). A file inside an ignored directory cannot be
# re-included, so the directory is ignored by contents (.claude/*).
.claude/*
!.claude/settings.local.json
.grok/
.cursor/
.pi/

# satelle process substrate (.satelle/) is tracked: workflows, skills,
# principles, constitution, satelle.toml, task definitions and documents.
# Its machine-local and runtime parts are not (sty_3f91b9e2). The re-include
# overrides a machine-wide core.excludesFile that ignores .satelle/.
!.satelle/
.satelle/**/.env
.satelle/logs
.satelle/hooks
.satelle/deployed.version
.satelle/*.local.toml
.satelle/tasks/*/exe_*.md

# Built binaries — leading `/` is required so only the *named path* is ignored.
# A bare `satelled` would also match cmd/satelled/ and hide the source.
/satelle
/satelled
/satelle-serve
/cmd/satelle/satelle
/cmd/satelled/satelled

# Opt-in live benchmark output (generated evidence, not source fixtures).
/tests/plannerbench/out/

# >>> satelle (managed) >>>
# .satelle/ is this repo's process substrate (workflows, skills, principles,
# constitution, satelle.toml, tasks, documents) and is tracked in git; only the
# machine-local state below is ignored. The re-include overrides a machine-wide
# core.excludesFile that ignores .satelle/. satelle adds only entries this file
# does not already settle; any rule written here or elsewhere is kept.
# Runtime state lives under ~/.satelle/<repo-key>/, outside the repo.
.satelle/satelle.local.toml
.satelle/workflows/agents.local.toml
.satelle/satelle
sty_*_body.md
sty_*_ac.md
# <<< satelle (managed) <<<
