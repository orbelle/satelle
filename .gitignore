# Harness wiring (.claude/, .grok/, .pi/, .cursor/) is tracked, so every clone
# gets the same hooks and settings. In .claude/ only the shared settings.json
# is tracked; Claude Code's runtime files there (locks, worktrees, checkpoints,
# settings.local.json) stay out. The !.claude/ re-include overrides a
# machine-wide git ignore that lists .claude/. Secrets (.env) stay out.
!.claude/
.claude/*
!.claude/settings.json
.env
AGENTS.md
CLAUDE.md

# satelle process substrate (.satelle/) is tracked: workflows, skills,
# principles, constitution, satelle.toml and agents.toml. Its run-time part
# (runs/) is ignored by .satelle/.gitignore; runtime state lives under
# ~/.satelle/<repo-key>/, outside the repo. The re-include overrides a
# machine-wide core.excludesFile that ignores .satelle/.
!.satelle/

# Built binaries — leading `/` is required so only the *named path* is ignored.
# A bare `satelled` would also match cmd/satelled/ and hide the source.
/satelle
/satelled
/satelle-serve
/cmd/satelle/satelle
/cmd/satelled/satelled

# Opt-in live benchmark output (generated evidence, not source fixtures).
/tests/plannerbench/out/
