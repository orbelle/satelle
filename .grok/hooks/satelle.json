{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "satelle hook gate --harness grok",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|search_replace|write|Bash|run_terminal_command"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "satelle hook context --harness grok",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "satelle hook stopcheck --harness grok",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "satelle hook prompt --harness grok",
            "type": "command"
          }
        ]
      }
    ]
  }
}
