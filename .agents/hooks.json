{
  "satelle": {
    "PreInvocation": [
      {
        "command": "satelle hook prompt --harness agy",
        "timeout": 10,
        "type": "command"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "satelle hook gate --harness agy",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|sed_file|notebook_edit|run_command"
      }
    ],
    "SessionStart": [
      {
        "command": "satelle hook context --harness agy",
        "timeout": 10,
        "type": "command"
      }
    ],
    "Stop": [
      {
        "command": "satelle hook stopcheck --harness agy",
        "timeout": 10,
        "type": "command"
      }
    ]
  }
}
